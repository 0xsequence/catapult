{
  "name": "@0xsequence/catapult",
  "version": "2.0.0",
  "description": "Ethereum contract deployment CLI tool",
  "main": "dist/index.js",
  "bin": {
    "catapult": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc && cp -r src/lib/std dist/lib/",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "start:dev": "npm run build && npm run start",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "jest --runInBand --detectOpenHandles",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "ethereum",
    "deployment",
    "cli",
    "smart-contracts",
    "blockchain",
    "typescript"
  ],
  "author": "Sequence (Agusx1211)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xsequence/catapult.git"
  },
  "bugs": {
    "url": "https://github.com/0xsequence/catapult/issues"
  },
  "homepage": "https://github.com/0xsequence/catapult#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "chai": "^5.3.3",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@safe-global/api-kit": "^5.0.1",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "ox": "^0.8.9",
    "solc": "^0.8.36",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
